# ── LLM (required) ──────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Anthropic fallback
ANTHROPIC_API_KEY=

# ── WhatsApp via Twilio (optional, needed for alerts) ───────────────────────
# Get keys at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your WhatsApp number (with country code, e.g. +919876543210)
USER_WHATSAPP=
